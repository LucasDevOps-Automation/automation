[Unit]
Description=Application service {{ project_name }}
After=network.target

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ app_home }}
Environment="PATH=/usr/local/bin:/usr/bin"
ExecStart=/usr/bin/python3 -m {{ project_name }}
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
