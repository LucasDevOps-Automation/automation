# Configuração de aplicação
# Gerado automaticamente pelo Ansible

app_name: "{{ project_name }}"
app_version: "{{ project_version }}"
environment: "{{ app_environment }}"
debug: false

server:
  host: "0.0.0.0"
  port: {{ app_port }}
  workers: 4

database:
  host: "{{ hostvars[groups['databases'][0]]['ansible_host'] | default('localhost') }}"
  port: 3306
  user: "{{ project_name }}"
  password: "{{ db_password | default('changeme') }}"
  name: "{{ project_name }}_db"

logging:
  level: "INFO"
  format: "json"
  file: "/var/log/{{ project_name }}/app.log"

security:
  secret_key: "{{ app_secret_key | default('change-me-in-production') }}"
  cors_enabled: true
  cors_origins: ["*"]
